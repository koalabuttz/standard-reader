                                            }
                                        ]
                                    }
                                ],
                                "plaintext": "Larger file sizes. 2mb is rough if I want to use this as a photography blog! Maybe this should just be part of the Pro tier, I dunno. "
                            }
                        },
                        {
                            "content": {
                                "$type": "app.offprint.block.text",
